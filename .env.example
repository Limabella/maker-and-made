# Copy this file to .env and replace only the API key value.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_TIMEOUT_SECONDS=30

# Optional MND-N psychology LightRAG settings.
PSYCH_RAG_ENABLED=false
PSYCH_RAG_INDEX_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
PSYCH_RAG_QUERY_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
PSYCH_RAG_EMBED_PROVIDER=ollama
PSYCH_RAG_EMBED_MODEL=bge-m3
PSYCH_RAG_EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
