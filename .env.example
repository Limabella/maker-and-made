# Copy this file to .env and replace only the API key value.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_SECONDS=30

# OpenAI-compatible endpoint used to compare the three context models.
# Ollama does not require a real API key, but some compatible servers do.
# Model names must match the IDs exposed by the selected server.
CONTEXT_MODEL_API_BASE_URL=http://localhost:11434/v1/chat/completions
CONTEXT_MODEL_API_KEY=
CONTEXT_MODEL_TIMEOUT_SECONDS=30
# Public benchmark aliases. Keep the source-model mapping only in local .env files.
CONTEXT_MODEL_A=onion-model-a
CONTEXT_MODEL_B=onion-model-b
CONTEXT_MODEL_C=onion-model-c

# Optional MND-N psychology LightRAG settings.
PSYCH_RAG_ENABLED=false
PSYCH_RAG_INDEX_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
PSYCH_RAG_QUERY_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
PSYCH_RAG_EMBED_PROVIDER=ollama
PSYCH_RAG_EMBED_MODEL=bge-m3
PSYCH_RAG_EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
